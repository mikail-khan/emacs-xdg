;;; ============================================================
;;; FILE: lisp/core/core-keys.el
;;; ============================================================

;;; core-keys.el --- keybindings -*- lexical-binding: t; -*-

(keymap-global-set "C-x k" #'kill-this-buffer)
(keymap-global-set "M-o" #'other-window)

(provide 'core-keys)


;;; ============================================================
;;; FILE: lisp/core/core-packages.el
;;; ============================================================

;;; core-packages.el --- package setup -*- lexical-binding: t; -*-

(require 'package)

;; XDG data directory for packages.
(let ((data-dir (or (getenv "XDG_DATA_HOME")
                    (expand-file-name "~/.local/share"))))
  (setq package-user-dir
        (expand-file-name "emacs/elpa/" data-dir)))

(setq package-archives
      '(("gnu"    . "https://elpa.gnu.org/packages/")
        ("nongnu" . "https://elpa.nongnu.org/nongnu/")
        ("melpa"  . "https://melpa.org/packages/")))

(package-initialize)

;; `use-package' is bundled with modern Emacs.
(require 'use-package)

(setq use-package-always-ensure t
      use-package-always-defer t)

(provide 'core-packages)


;;; ============================================================
;;; FILE: lisp/core/core-perf.el
;;; ============================================================

;;; core-perf.el --- performance settings -*- lexical-binding: t; -*-

(add-hook 'emacs-startup-hook
(lambda ()
(setq gc-cons-threshold (* 16 1024 1024)
gc-cons-percentage 0.1)))

(setq read-process-output-max (* 1024 1024))

(provide 'core-perf)


;;; ============================================================
;;; FILE: lisp/core/core-ui.el
;;; ============================================================

;;; core-ui.el --- UI defaults -*- lexical-binding: t; -*-

(setq inhibit-startup-screen t)
(setq ring-bell-function 'ignore)
(setq use-dialog-box nil)

(provide 'core-ui)


;;; ============================================================
;;; FILE: lisp/modules/mod-completion.el
;;; ============================================================

;;; mod-completion.el --- completion stack -*- lexical-binding: t; -*-

(use-package savehist
  :init
  (savehist-mode))

(use-package vertico
  :init
  (vertico-mode)
  :custom
  (vertico-cycle t))

(use-package orderless
  :init
  (setq completion-styles '(orderless basic)
        completion-category-defaults nil
        completion-category-overrides
        '((file (styles basic partial-completion))
          (eglot (styles orderless basic)))))

(use-package marginalia
  :init
  (marginalia-mode))

(use-package consult
  :bind (("C-s" . consult-line)
         ("C-x b" . consult-buffer)))

(use-package corfu
  :init
  (global-corfu-mode)
  :custom
  (corfu-auto t)
  (corfu-auto-delay 0.0)
  ;; Avoid popping completion before any meaningful input.
  (corfu-auto-prefix 1)
  (corfu-cycle t)
  (corfu-preselect 'prompt)
  (corfu-quit-no-match 'separator))

(use-package cape
  :init
  ;; Keep global CAPFs conservative; language-aware completion such as
  ;; Eglot gets to do its job without a global keyword CAPF competing.
  (add-hook 'completion-at-point-functions #'cape-file)
  (add-hook 'completion-at-point-functions #'cape-dabbrev))

(use-package tempel
  :bind
  (("M-+" . tempel-complete)
   ("M-*" . tempel-insert))
  :custom
  (tempel-path
   (list (expand-file-name "templates/*.eld" user-emacs-directory))))

(use-package tempel-collection
  :after tempel)

(use-package embark
  :bind
  (("C-." . embark-act)
   ("C-;" . embark-dwim)
   ("C-h B" . embark-bindings))
  :init
  (setq prefix-help-command #'embark-prefix-help-command))

(use-package embark-consult
  :after (embark consult)
  :hook
  (embark-collect-mode . consult-preview-at-point-mode))

(setq tab-always-indent 'complete
      completion-cycle-threshold 3)

(provide 'mod-completion)


;;; ============================================================
;;; FILE: lisp/modules/mod-eglot.el
;;; ============================================================

;;; mod-eglot.el --- LSP configuration -*- lexical-binding: t; -*-

(use-package eglot
  :ensure nil
  :commands (eglot eglot-ensure)
  :custom
  (eglot-autoshutdown t)
  (eglot-sync-connect nil)
  (eglot-extend-to-xref t)
  (eglot-events-buffer-size 0)
  (eglot-report-progress nil)
  :config
  ;; Python -> basedpyright. Individual language modules decide when Eglot
  ;; starts; do not enable it for every `prog-mode' buffer.
  (add-to-list 'eglot-server-programs
               '((python-mode python-ts-mode)
                 . ("basedpyright-langserver" "--stdio"))))

(provide 'mod-eglot)


;;; ============================================================
;;; FILE: lisp/modules/mod-latex.el
;;; ============================================================

;;; mod-latex.el --- LaTeX and mathematics editing -*- lexical-binding: t; -*-

;;; Commentary:
;;
;; LaTeX environment for:
;;
;;   - GNU Emacs 30.x / emacs-nox
;;   - AUCTeX 14.x
;;   - TeX Live
;;   - latexmk
;;   - Okular
;;   - SyncTeX forward/inverse search
;;   - RefTeX
;;   - CDLaTeX
;;
;; PDF viewing is external: Okular.
;; No graphical Emacs/PDF Tools integration is required.

;;; Code:

;; ---------------------------------------------------------------------------
;; Per-buffer setup
;; ---------------------------------------------------------------------------

(defun my/latex-mode-setup ()
  "Configure a LaTeX buffer for this machine and workflow."

  ;; Soft wrapping is preferable for prose-heavy TeX source.
  (visual-line-mode 1)

  ;; Let latexmk handle the complete build dependency graph when available.
  ;; AUCTeX 14.x provides LaTeXMk natively.
  (when (executable-find "latexmk")
    (setq-local TeX-command-default "LaTeXMk")))


;; ---------------------------------------------------------------------------
;; AUCTeX
;; ---------------------------------------------------------------------------

(use-package tex
  :ensure auctex

  ;; Use AUCTeX's LaTeX mode for .tex files.
  :mode ("\\.tex\\'" . LaTeX-mode)

  :init

  ;; For multifile documents, let AUCTeX try to discover the master file
  ;; instead of assuming every included chapter/section is standalone.
  ;;
  ;; AUCTeX may write a TeX-master file-local variable once it determines
  ;; the relationship.
  (setq-default TeX-master 'dwim)

  :custom

  ;; -------------------------------------------------------------------------
  ;; Document parsing
  ;; -------------------------------------------------------------------------

  ;; Save AUCTeX's parsed knowledge of document classes, packages,
  ;; environments, commands, labels, etc.
  (TeX-auto-save t)

  ;; Parse documents when they are opened.
  (TeX-parse-self t)

  ;; Save document buffers automatically before running TeX commands.
  (TeX-save-query nil)

  ;; -------------------------------------------------------------------------
  ;; Output
  ;; -------------------------------------------------------------------------

  ;; Produce PDF directly by default.
  ;;
  ;; This remains buffer-local inside AUCTeX, so individual projects can
  ;; override it if they genuinely require a DVI workflow.
  (TeX-PDF-mode t)

  ;; -------------------------------------------------------------------------
  ;; SyncTeX / Okular
  ;; -------------------------------------------------------------------------

  ;; Generate source/output correlation information.
  (TeX-source-correlate-mode t)

  ;; Explicitly use SyncTeX rather than source-specials/pdfsync.
  (TeX-source-correlate-method 'synctex)

  ;; Start an Emacs server automatically when AUCTeX invokes the viewer.
  ;; This is required for Okular -> terminal Emacs inverse search.
  (TeX-source-correlate-start-server t)

  ;; Explicitly select AUCTeX's built-in Okular definition for PDFs.
  ;;
  ;; The built-in definition already knows how to invoke Okular using
  ;; --unique and how to add SyncTeX source coordinates.
  (TeX-view-program-selection
   '((output-pdf "Okular")))

  ;; -------------------------------------------------------------------------
  ;; Compilation diagnostics
  ;; -------------------------------------------------------------------------

  ;; Parse the complete TeX log so all errors/warnings can be navigated.
  (TeX-parse-all-errors t)

  ;; Automatically show AUCTeX's error overview when compilation actually
  ;; produces errors or warnings worth reporting.
  ;;
  ;; With emacs-nox this appears as an ordinary terminal Emacs window;
  ;; no graphical frame is required.
  (TeX-error-overview-open-after-TeX-run t)

  ;; Keep the error overview inside the current terminal Emacs frame.
  (TeX-error-overview-setup nil)

  :hook
  (LaTeX-mode . my/latex-mode-setup))


;; ---------------------------------------------------------------------------
;; RefTeX
;; ---------------------------------------------------------------------------

(use-package reftex
  :ensure nil
  :after tex

  :custom

  ;; Integrate RefTeX's labels, references, citations and indices with
  ;; AUCTeX's document/style information.
  (reftex-plug-into-AUCTeX t)

  :hook
  (LaTeX-mode . reftex-mode))


;; ---------------------------------------------------------------------------
;; CDLaTeX
;; ---------------------------------------------------------------------------

(use-package cdlatex
  :after tex

  :hook
  ((LaTeX-mode . turn-on-cdlatex)
   (org-mode   . turn-on-org-cdlatex)))


(provide 'mod-latex)

;;; mod-latex.el ends here

