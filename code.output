  (org-directory "~/org")
  (org-file-apps
   '((auto-mode . emacs)
     ("\\.\\(png\\|jpe?g\\|gif\\|webp\\)\\'" . "feh %s")
     (t . "xdg-open %s"))))

(use-package org-roam
  :after org
  :custom
  (org-roam-directory (expand-file-name "org-roam" org-directory))
  (org-roam-completion-everywhere t)
